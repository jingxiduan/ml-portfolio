# Copy this file to `.env` and fill in your keys locally.
# NEVER commit the real `.env` to git — it's listed in .gitignore.

# Pexels API — https://www.pexels.com/api/  (free, immediate signup)
PEXELS_API_KEY=

# HuggingFace token — only needed if you want to pre-login to HF Hub
#   https://huggingface.co/settings/tokens  (read-only token is fine)
HF_TOKEN=

# Optional: Weights & Biases
WANDB_API_KEY=
